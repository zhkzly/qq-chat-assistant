{
 "contract": "fidelity_result",
 "version": "fidelity-result-contract-v4",
 "description": "Read-only sparse source-fact defects and speech-act-independent disclosure checks, with candidate-bound claims and explicit privacy bases.",
 "protocols": [
  "full",
  "sparse-defects-v1"
 ],
 "fields": {
  "checkRef": {
   "type": "enum",
   "values": [
    "c1"
   ],
   "required": true
  },
  "auditProtocol": {
   "type": "enum",
   "values": [
    "sparse-defects-v1"
   ]
  },
  "verdict": {
   "type": "enum",
   "values": [
    "allow",
    "reject",
    "uncertain"
   ],
   "optional": true
  },
  "factual": {
   "type": "array",
   "max": 32,
   "item": {
    "path": {
     "payloadEnum": "candidatePaths"
    },
    "statements": {
     "type": "array",
     "max": 12
    }
   }
  },
  "issues": {
   "type": "array",
   "item": {
    "path": {
     "payloadEnum": "candidatePaths"
    },
    "code": {
     "full": [
      "private_disclosure"
     ],
     "sparse": [
      "unsupported_fact",
      "evidence_mismatch",
      "omitted_qualifier",
      "internal_conflict",
      "private_disclosure"
     ]
    },
    "claim": {
     "kinds": [
      "assertion",
      "presupposition",
      "intent",
      "opinion",
      "open_question",
      "advice",
      "inspection",
      "private_conditional"
     ],
     "hardFactKinds": [
      "assertion",
      "presupposition"
     ],
     "quote": {
      "type": "string",
      "maxLength": 1200
     },
     "requiredForProtocol": "sparse-defects-v1",
     "hardFactCodes": [
      "unsupported_fact",
      "evidence_mismatch",
      "omitted_qualifier",
      "internal_conflict"
     ]
    },
    "privacyBasis": {
     "values": [
      "absence_of_grant",
      "explicit_restriction"
     ],
     "requiredForCodes": [
      "private_disclosure"
     ]
    }
   }
  },
  "concerns": {
   "type": "array",
   "item": {
    "path": {
     "payloadEnum": "candidatePaths"
    },
    "code": {
     "type": "string"
    }
   }
  }
 }
}
