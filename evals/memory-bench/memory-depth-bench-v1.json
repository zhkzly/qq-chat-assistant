   "private_events": [],
   "request": {
    "id": "rq-3",
    "at": "2026-11-07T10:00:00+08:00",
    "text": "我不是说过我开始跑步锻炼了吗？最近跑得咋样帮我总结一下？"
   },
   "user_controls": {
