   }
  },
  {
   "id": "qa-9-abstention",
   "as_of": "2026-11-13T10:00:00+08:00",
   "qq_events": [],
   "private_events": [],
   "request": {
    "id": "rq-9",
    "at": "2026-11-13T10:00:00+08:00",
    "text": "我生日是几月几号来着？你跟我说过的。"
   },
   "user_controls": {
