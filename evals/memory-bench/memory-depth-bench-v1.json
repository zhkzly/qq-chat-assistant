   "private_events": [],
   "request": {
    "id": "rq-5",
    "at": "2026-11-09T10:00:00+08:00",
    "text": "阿杰是我什么时期的同学？她婚礼在哪个区办？"
   },
   "user_controls": {
    "automatic": false
   }
  },
  {
   "id": "qa-6-multi-hop",
   "as_of": "2026-11-10T10:00:00+08:00",
   "qq_events": [],
   "private_events": [],
   "request": {
    "id": "rq-6",
    "at": "2026-11-10T10:00:00+08:00",
    "text": "生日聚会上我说要表演什么乐器？在哪家咖啡馆办的？"
   },
   "user_controls": {
