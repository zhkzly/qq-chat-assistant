{
  "name": "qq-chat-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time read-only QQ conversation assistance with manual copy/send",
  "type": "commonjs",
  "scripts": {
    "test": "node scripts/test.cjs",
    "start": "bash scripts/launch.sh",
    "check": "node scripts/check.cjs",
    "web": "node src/server.cjs",
    "diagnose": "node scripts/diagnose.cjs",
    "test:ui": "node scripts/browser-check.cjs",
    "test:assistant-ui": "node scripts/assistant-browser-check.cjs",
    "test:goal-replay": "node scripts/context-goal-replay.cjs",
    "test:relationship-goal": "node scripts/relationship-goal-check.cjs",
    "test:experience-browser": "node scripts/experience-browser-check.cjs",
    "test:direction-ui": "node scripts/direction-browser-check.cjs",
    "test:direction-goal": "node scripts/direction-goal-check.cjs",
    "test:mode-ui": "node scripts/mode-browser-check.cjs",
    "test:compaction-goal": "node scripts/compaction-goal-check.cjs",
    "test:recovery-ui": "node scripts/response-recovery-browser-check.cjs",
    "test:recovery-goal": "node scripts/response-recovery-goal-check.cjs",
    "test:readiness-ui": "node scripts/native-readiness-browser-check.cjs",
    "test:current-task-ui": "node scripts/current-task-browser-check.cjs",
    "test:current-task-goal": "node scripts/current-task-goal-check.cjs",
    "test:refresh-ui": "node scripts/refresh-preservation-browser-check.cjs",
    "test:candidates-ui": "node scripts/candidate-browser-check.cjs",
    "test:topic-lifecycle-ui": "node scripts/topic-lifecycle-browser-check.cjs",
    "test:model-error-ui": "node scripts/model-error-browser-check.cjs",
    "test:vision-ui": "node scripts/vision-browser-check.cjs",
    "test:explanation-ui": "node scripts/explanation-browser-check.cjs",
    "test:goal-acceptance": "node scripts/goal-acceptance-check.cjs",
    "eval:check": "node scripts/eval-dataset.cjs check",
    "eval:list": "node scripts/eval-dataset.cjs list",
    "eval:case": "node scripts/eval-dataset.cjs show",
    "eval:replay": "node scripts/eval-replay-cli.cjs --adapter ./scripts/eval-qq-adapter.cjs",
    "eval:replay:list": "node scripts/eval-replay-cli.cjs --list",
    "eval:judge:check": "node scripts/eval-reviewer-calibration.cjs check",
    "eval:judge:export": "node scripts/eval-reviewer-calibration.cjs export",
    "eval:judge:compare": "node scripts/eval-reviewer-calibration.cjs compare",
    "goal:roles": "python3 scripts/goal-agent-config.py check",
    "goal:round": "node scripts/goal-round.cjs",
    "goal:status": "node scripts/goal-round.cjs status"
  },
  "engines": {
    "node": ">=22"
  }
}
